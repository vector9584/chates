win/data-stage/
win/data.zip
*.zip

# ---- 构建产物（2026-11-25 发布链）----
# electron/resources 是本机组装的 516MB 资源树（内核/python/node），
# CI 每次现场重建，绝不进 git。误 git add -A 会把仓库撑爆。
electron/resources/
electron/dist/
electron/node_modules/
node_modules/
tests-js/node_modules/
dist/
# 只忽略仓库根下的 build/ 产物目录。曾经写成 build/（任何层级），
# 把 electron/build/installer.nsh 这个 NSIS 安装钩子一起吞了 ——
# 结果钩子从没进过 git，CI 打出来的包是没有 taskkill 的版本。
/build/
# 从 kernel/hermes-src.tgz 解出来的内核副本，可重建，不进 git
app/hermes-src/
.skeleton-report
kernel/*.fpk
# 内核快照是 CI 产物，挂 Release(tag=kernel) 上，不进 git
kernel/*.tgz
__pycache__/
*.pyc
.pytest_cache/
*.tsbuildinfo

# ---- 本地改动备份（2026-11-26 清理 60 个遗留）----
# 改源码时的 .bak-* 副本一律不入库：git 本身就有历史，
# 这些文件只会让仓库根目录和 agent/ gateway/ 越堆越乱。
*.bak-*
*.orig
*.rej

# 版本号水位（version.py 本地计数，每台构建机各自维护）
.version-state.json

# 本机构建用的上报地址（真域名不进公开仓）
release-tools/.report-url
