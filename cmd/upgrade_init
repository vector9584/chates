#!/bin/bash

# TRIM_APPDEST = /var/apps/<appname>，本应用专属，不含兄弟应用。
# 不能用 "node.*monitor.js" / "hermes.*gateway" 这类宽匹配：
# 并行装了原 Hermes 时，那些进程同样叫 hermes gateway，
# 升级 CHATÈS 会把正在跑的 Hermes 一起杀掉（2026-11-26 实测确认）。
APPDEST="${TRIM_APPDEST:-}"
PKGHOME="${TRIM_PKGHOME:-}"

if [ -n "$APPDEST" ]; then
    # monitor.js 在 APPDEST/server/ 下
    pkill -9 -f "${APPDEST}/.*monitor\.js"          2>/dev/null || true
    pkill -9 -f "${APPDEST}/.*panel_lifecycle"      2>/dev/null || true
fi

if [ -n "$PKGHOME" ]; then
    # gateway/dashboard 用 PKGHOME 下 venv 里的 hermes
    pkill -9 -f "${PKGHOME}/.*gateway"              2>/dev/null || true
    pkill -9 -f "${PKGHOME}/.*dashboard"            2>/dev/null || true
    pkill -9 -f "${PKGHOME}/.*mcp_stdio"            2>/dev/null || true
fi

exit 0
