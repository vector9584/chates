#!/bin/bash

### 安装前回调 — 清理残留进程和 socket，避免安装时权限设置失败

TRIM_APPDEST="${TRIM_APPDEST:-/var/apps/chates}"
TRIM_PKGHOME="${TRIM_PKGHOME:-/var/apps/chates/home}"
TRIM_PKGVAR="${TRIM_PKGVAR:-/vol3/@appdata/chates}"
LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [install_init] $1"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null || true
}

log_msg "=== install_init start ==="
log_msg "TRIM_APPDEST=${TRIM_APPDEST}"
log_msg "TRIM_PKGVAR=${TRIM_PKGVAR}"
log_msg "TRIM_USERNAME=${TRIM_USERNAME:-<empty>}"

# 记录安装前目录状态
log_msg "--- 目录状态 (安装前) ---"
ls -la "${TRIM_APPDEST}" 2>&1 | while IFS= read -r line; do log_msg "  $line"; done

# 强制 kill 可能残留的进程 —— 只认 CHATES 自己的路径，
# 绝不能用 "node.*monitor.js" / "hermes.*gateway" 这种宽匹配：
# 那会把同机的 hermes-agent 一起杀掉（2026-11-26 踩过）。
pkill -9 -f "@appcenter/chates/.*monitor\.js" 2>/dev/null || true
pkill -9 -f "@appcenter/chates/.*panel_lifecycle" 2>/dev/null || true

# 等待进程完全退出（最多 10 秒），避免文件句柄残留导致 fnOS 权限设置失败
_wait=0
while [ ${_wait} -lt 10 ]; do
    if ! pgrep -f "@appcenter/chates/.*monitor\.js" >/dev/null 2>&1 \
       && ! pgrep -f "@appcenter/chates/.*panel_lifecycle" >/dev/null 2>&1; then
        break
    fi
    sleep 1
    _wait=$((_wait + 1))
done
log_msg "进程清理完成 (等待 ${_wait}s)"

# 删除残留 socket
rm -f "${TRIM_APPDEST}/chates.sock" 2>/dev/null || true
rm -f "/var/apps/chates/target/chates.sock" 2>/dev/null || true
log_msg "socket 清理完成"

# 清理运行时状态残留（2026-11-26 踩过，装到已有数据目录时必现）：
# data/ 若是从别的实例（hermes-agent）复制来的，gateway.pid / gateway.lock /
# gateway_state.json 里记着原实例的 PID 与 start_time。原进程还活着时，
# 新 gateway 启动会判定「Another gateway instance is already running」直接退出，
# 表现为 gateway 起不来、QQ/微信/Discord 全部断连、面板显示无实例。
# 安装/升级时本应用已停，这些文件本就该由新进程重写，清掉是安全的。
for _d in "${TRIM_PKGHOME}/data" "/var/apps/chates/home/data" "/vol3/@apphome/chates/data"; do
    [ -d "$_d" ] || continue
    for _f in gateway.pid gateway.lock gateway_state.json app.pid dashboard.pid dashboard.token; do
        if [ -e "$_d/$_f" ]; then
            rm -f "$_d/$_f" 2>/dev/null || true
            log_msg "清理运行时状态残留: $_d/$_f"
        fi
    done
done
log_msg "运行时状态清理完成"

# 端口冲突清理：只清理 CHATES 自己的端口（8660 UI / 8752 gateway / 9239 dashboard）。
# 绝不能碰 8650/8742/9219 —— 那是同机 hermes-agent 的端口，抢了就把原应用打断。
for PORT in 8660 8752 9239; do
    PID=$(ss -tlnp 2>/dev/null | grep ":${PORT} " | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)
    if [ -n "$PID" ]; then
        # 端口是 CHATES 专属的，占着就是自己的残留
        log_msg "端口 ${PORT} 被 pid=${PID} 占用（CHATES 专属端口），清理残留"
        kill -9 "$PID" 2>/dev/null || true
    fi
done
sleep 1
log_msg "端口冲突清理完成"

# 清理残留的版本覆盖文件（@appdata 不随卸载清除，旧 override 会导致 UI 显示旧版本号）
rm -f "${TRIM_PKGVAR}/app_version" 2>/dev/null || true
log_msg "app_version 覆盖文件清理完成"

# 全新安装检测：hermes 从未配置过（无 config.yaml）时，@appdata 残留的配置类文件
# （上一环境的 extensions.json / providers-state 等）会导致新装后左侧会话树
# 出现一堆旧角色分组、模型页出现不可用的假 provider。
# 仅清理配置类文件，保留 chat/ 会话历史与日志；升级安装（有 config.yaml）不动。
# 注意：appcenter-cli install-fpk 可能不传 TRIM_PKGHOME env → 探测实际路径，防误判全新安装清空配置
_HAS_CFG=0
for _cand in "${TRIM_PKGHOME}/data/config.yaml" \
             "/var/apps/chates/home/data/config.yaml" \
             "/vol3/@apphome/chates/data/config.yaml"; do
  if [ -f "$_cand" ]; then _HAS_CFG=1; break; fi
done
if [ "$_HAS_CFG" = "0" ]; then
    rm -f "${TRIM_PKGVAR}/extensions.json" \
          "${TRIM_PKGVAR}/providers-state.yaml" \
          "${TRIM_PKGVAR}/provider-models.json" \
          "${TRIM_PKGVAR}/.env.providers" 2>/dev/null || true
    log_msg "全新安装（未探测到 hermes 配置）：残留配置类文件清理完成"
else
    log_msg "检测到已有 hermes 配置（升级安装），保留 @appdata 配置"
fi

# 额外等待 2 秒，确保文件系统释放所有句柄
sleep 2

# 记录清理后目录状态
log_msg "--- 目录状态 (清理后) ---"
ls -la "${TRIM_APPDEST}" 2>&1 | while IFS= read -r line; do log_msg "  $line"; done

log_msg "=== install_init end ==="
exit 0

